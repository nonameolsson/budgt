{
	"builds": [
		{
			"config": {
				"distDir": "build"
			},
			"src": "package.json",
			"use": "@vercel/static-build"
		},
		{
			"src": "api/index.js",
			"use": "@vercel/node"
		}
	],
	"routes": [
		{
			"dest": "/api/index.js",
			"src": "/api/(.*)"
		},
		{
			"dest": "/index.html",
			"src": "/(.*)"
		}
	],
	"version": 2
}
